<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ page.url | url }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ build.stamp }}">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="site-title" href="{{ '/' | url }}">{{ site.title }}</a>
      <nav class="site-nav">
        <a href="{{ '/' | url }}">Home</a>
        <details class="nav-dropdown">
          <summary>Classes</summary>
          <div class="dropdown-menu">
            <a href="{{ '/classes/' | url }}">All Classes</a>
            {% for cls in classes %}
            {% if cls.slug == "alchemist" or cls.slug == "bard" %}
            <details class="nav-subdropdown">
              <summary>{{ cls.name }}</summary>
              <div class="dropdown-submenu">
                <a href="{{ ('/classes/' ~ cls.slug ~ '/') | url }}">Overview</a>
                {% if cls.slug == "alchemist" %}
                <a href="{{ ('/classes/' ~ cls.slug ~ '/feats/') | url }}">Feats</a>
                <a href="{{ ('/classes/' ~ cls.slug ~ '/items/') | url }}">Items</a>
                {% elif cls.slug == "bard" %}
                <a href="{{ ('/classes/' ~ cls.slug ~ '/features/') | url }}">Features</a>
                {% endif %}
              </div>
            </details>
            {% else %}
            <a href="{{ ('/classes/' ~ cls.slug ~ '/') | url }}">{{ cls.name }}</a>
            {% endif %}
            {% endfor %}
          </div>
        </details>
        <details class="nav-dropdown">
          <summary>General</summary>
          <div class="dropdown-menu">
            <a href="{{ '/general/terminology/' | url }}">Terminology</a>
            <a href="{{ '/general/traits/' | url }}">Traits</a>
            <a href="{{ '/general/spells/' | url }}">Spells</a>
            <details class="nav-subdropdown">
              <summary>Items</summary>
              <div class="dropdown-submenu">
                <a href="{{ '/general/items/' | url }}">Overview</a>
                <a href="{{ '/general/items/consumables/' | url }}">Consumables</a>
              </div>
            </details>
          </div>
        </details>
        <a href="{{ '/about/' | url }}">About</a>
      </nav>
    </div>
  </header>

  {% if page.url != "/" %}
  {% set crumbs = menus[menu] if menu else [] %}
  <nav class="breadcrumbs wrap" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ '/' | url }}">Home</a></li>
      {% for crumb in crumbs %}
      {% if crumb.url and crumb.url != page.url %}
      <li><a href="{{ crumb.url | url }}">{{ crumb.title }}</a></li>
      {% elif crumb.url %}
      <li aria-current="page">{{ crumb.title }}</li>
      {% else %}
      <li>{{ crumb.title }}</li>
      {% endif %}
      {% endfor %}
      {% if not crumbs.length or (crumbs | last).url != page.url %}
      <li aria-current="page">{{ title }}</li>
      {% endif %}
    </ol>
  </nav>
  {% endif %}

  <main class="wrap">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <nav aria-label="Site information">
        <ul class="footer-links">
          <li><a href="{{ '/about/#licensing' | url }}">Licensing</a></li>
          <li><a href="{{ '/about/#ai-usage' | url }}">AI Usage</a></li>
        </ul>
      </nav>
    </div>
  </footer>
</body>
</html>
